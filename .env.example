# ------------------------------
# DATABASE
# ------------------------------
# Nom de l'utilisateur PostgreSQL
DB_USER=<your_db_user>

# Mot de passe PostgreSQL
DB_PASSWORD=<your_db_password>

# Nom de la base de données
DB_NAME=<your_db_name>

# Host de la DB (Docker service name)
DB_HOST=<your_db_host> # !! `db` pour Docker, `localhost` si on utilise pas docker

# URL complète pour Sequelize (ou autre ORM)
PG_URL=postgres://<your_db_user>:<your_db_password>@<your_db_host>/<your_db_name>

# ------------------------------
# SESSION
# ------------------------------
# Secret pour express-session
SESSION_SECRET=<your_session_secret>

# Nom du cookie de session
SESSION_NAME=<your_session_name>

# Durée max de la session (ms)
SESSION_MAX_AGE=<your_session_max_age>

# ------------------------------
# SERVER
# ------------------------------
# Port de l'application Node.js
PORT=<your_app_port>
